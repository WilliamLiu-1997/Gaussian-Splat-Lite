{
  "name": "gaussian-splat-lite",
  "version": "0.1.10",
  "description": "A lightweight Three.js Gaussian Splatting renderer with PLY/SPZ loading, WebAssembly-accelerated sorting and raycasting, multi-Splat rendering, and high-precision GIS/ECEF coordinate support",
  "author": "William Liu <lyz15972107087@gmail.com>",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist/gaussian-splat-lite.cjs",
  "module": "./dist/gaussian-splat-lite.module.js",
  "types": "./dist/types/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.mts",
        "default": "./dist/gaussian-splat-lite.module.js"
      },
      "require": {
        "types": "./dist/types/index.d.cts",
        "default": "./dist/gaussian-splat-lite.cjs"
      }
    }
  },
  "scripts": {
    "build": "npm run build:production && npm run build:dev && npm run build:types:cjs",
    "build:dev": "vite build --mode dev",
    "build:production": "vite build --mode production",
    "build:site": "vite build --config vite.site.config.ts",
    "build:types:cjs": "node scripts/build-cjs-types.js",
    "build:wasm": "node rust/build_wasm.js",
    "build:watch": "onchange 'src/**/*.{ts,glsl}' -- npm run build:dev",
    "check": "tsc --noEmit",
    "check:rust": "cargo fmt --manifest-path rust/Cargo.toml --all -- --check",
    "clean": "rm -rf dist/ node_modules/ rust/target/ rust/gaussian-splat-rs/pkg/",
    "dev": "npm run build:dev && node scripts/dev.js",
    "format": "biome format .",
    "format:fix": "biome format . --fix",
    "lint": "biome check .",
    "lint:fix": "biome check . --fix",
    "pack:check": "npm pack --dry-run && publint",
    "prepack": "npm run check && npm run check:rust && npm run lint && npm test && npm run build",
    "release:check": "npm run build:wasm && npm run build:site && npm run pack:check",
    "start": "npm run dev",
    "test": "npm run test:js && npm run test:rust",
    "test:js": "node --no-warnings --loader ts-node/esm --test test/*.test.ts",
    "test:rust": "cargo test --manifest-path rust/Cargo.toml --workspace --locked"
  },
  "files": [
    "dist",
    "docs",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "Gaussian-Splat-Lite.svg",
    "LICENSE",
    "NOTICE",
    "README.md",
    "THIRD_PARTY_LICENSES.md"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WilliamLiu-1997/Gaussian-Splat-Lite.git"
  },
  "homepage": "https://github.com/WilliamLiu-1997/Gaussian-Splat-Lite#readme",
  "bugs": {
    "url": "https://github.com/WilliamLiu-1997/Gaussian-Splat-Lite/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/three": "0.185.1",
    "gaussian-splat-rs": "file:rust/gaussian-splat-rs/pkg",
    "onchange": "7.1.0",
    "publint": "0.3.24",
    "three": "^0.185.1",
    "ts-node": "10.9.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vite-plugin-arraybuffer": "^0.1.4",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-glsl": "^1.3.1"
  },
  "peerDependencies": {
    "three": ">=0.185.1"
  },
  "keywords": [
    "3d",
    "3dgs",
    "ecef",
    "gaussian-splatting",
    "gis",
    "gsplats",
    "ply",
    "spz",
    "three.js",
    "threejs",
    "webassembly",
    "webgl"
  ],
  "allowScripts": {
    "@biomejs/biome@1.9.4": true,
    "esbuild@0.25.2": true,
    "fsevents@2.3.3": true
  }
}
