{
  "name": "gaussian-splat-lite",
  "version": "0.1.0",
  "description": "A focused Three.js Gaussian Splatting renderer with PLY and SPZ loading",
  "type": "module",
  "main": "./dist/gaussian-splat-lite.cjs",
  "module": "./dist/gaussian-splat-lite.module.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/gaussian-splat-lite.module.js",
      "require": "./dist/gaussian-splat-lite.cjs"
    }
  },
  "scripts": {
    "build": "npm run build:production && npm run build:dev",
    "build:dev": "vite build --mode dev",
    "build:production": "vite build --mode production",
    "build:wasm": "node rust/build_wasm.js",
    "build:watch": "onchange 'src/**/*.{ts,glsl}' -- npm run build:dev",
    "clean": "rm -rf dist/ node_modules/ rust/target/ rust/spark-worker-rs/pkg/ rust/spark-rs/pkg/",
    "dev": "npm run build:dev && node scripts/dev.js",
    "format": "biome format .",
    "format:fix": "biome format . --fix",
    "lint": "biome check .",
    "lint:fix": "biome check . --fix",
    "prepare": "npm run build:wasm",
    "start": "npm run dev",
    "test": "node --no-warnings --loader ts-node/esm --test test/**/*.test.ts"
  },
  "files": ["dist"],
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/three": "0.180.0",
    "magic-string": "^0.30.17",
    "onchange": "7.1.0",
    "spark-rs": "file:rust/spark-rs/pkg",
    "spark-worker-rs": "file:rust/spark-worker-rs/pkg",
    "three": "^0.180.0",
    "ts-node": "10.9.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-glsl": "^1.3.1"
  },
  "peerDependencies": {
    "three": ">=0.180.0"
  },
  "keywords": [
    "3d",
    "three.js",
    "gsplats",
    "3dgs",
    "gaussian",
    "splats",
    "ply",
    "spz",
    "webgl"
  ]
}
