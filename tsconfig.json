{
  "compilerOptions": {
    "target": "es2020",
    "module": "es2020",
    "lib": ["ES2020", "DOM"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": false,
    "moduleResolution": "bundler",
    "noEmit": true,
    "types": []
  },
  "include": ["src/**/*.d.ts"],
  "exclude": ["node_modules", "dist", "examples"]
}
